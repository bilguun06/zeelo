# ── Runtime ──
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS (admin dashboard, Expo web)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Database / cache ──
DATABASE_URL=postgresql://orgil:orgil_dev_password@localhost:5432/orgil?schema=public
# Optional. Without it an in-memory store is used (single instance, dev only).
REDIS_URL=redis://localhost:6379

# ── Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ──
JWT_ACCESS_SECRET=change-me-user-access-secret-min-32-chars
JWT_ADMIN_SECRET=change-me-admin-access-secret-min-32-chars
# 32 bytes, base64. Encrypts register numbers, account numbers, MFA secrets, uploaded documents.
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY_xxxxxxxxxxxx=
# Keyed hash for searchable lookups of encrypted fields
HMAC_KEY=change-me-hmac-key-min-32-chars-xxxxxxxxxxxx

# ── Auth policy ──
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_TOKEN_TTL_SECONDS=1800
# DEV ONLY: include OTP in API response so you can test without an SMS gateway. Forced off in production.
OTP_DEV_ECHO=true

# ── SMS gateway (mock logs to console until configured) ──
SMS_PROVIDER=mock

# ── Storage ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# ── Payments ──
# Sandbox provider: explicit test payments only — NEVER real money. Forced off in production.
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_WEBHOOK_SECRET=change-me-webhook-signing-secret
PUBLIC_API_URL=http://localhost:4000
# QPay merchant credentials (leave empty until a merchant contract exists — provider stays disabled)
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# SocialPay (Golomt) credentials
SOCIALPAY_BASE_URL=
SOCIALPAY_TERMINAL=
SOCIALPAY_KEY=

# ── Seed ──
SEED_ADMIN_EMAIL=admin@orgil.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
